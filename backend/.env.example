# ==============================
# SERVER
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# DATABASE (MongoDB Atlas)
# ==============================
MONGO_URI=

# ==============================
# JWT AUTH
# ==============================
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ==============================
# ADMIN SEED CREDENTIALS
# (used once by `npm run seed:admin`)
# ==============================
ADMIN_NAME=Nayeem
ADMIN_EMAIL=admin@nayeem.dev
ADMIN_PASSWORD=change_this_password

# ==============================
# CORS
# ==============================
CLIENT_URL=http://localhost:5500

# ==============================
# EMAIL (Contact Form - Nodemailer)
# Use a Gmail App Password or any SMTP provider (e.g. Resend, SendGrid, Mailtrap)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
